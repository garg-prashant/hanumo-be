# Database
DATABASE_URL="postgresql://username:password@localhost:5432/hanumo_rental?schema=public"

# Server Configuration
PORT=3000
NODE_ENV=development
BACKEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Privy Configuration
PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_SECRET=your_privy_app_secret_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# X402 Payment Configuration
X402_PROVIDER_URL=https://api.x402provider.com
X402_API_KEY=your_x402_api_key_here

# Blockchain Configuration
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-project-id
USDC_CONTRACT_ADDRESS=0xA0b86a33E6441b8C4C8C0C4C0C4C0C4C0C4C0C4C
TENANT_PRIVATE_KEY=your_tenant_private_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
