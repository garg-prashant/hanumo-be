// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Note: SQLite doesn't support enums, using String with constraints instead

model User {
  id             Int     @id @default(autoincrement())
  // Privy authentication fields
  privyId        String? @unique @map("privy_id")
  profileId      String? @map("profile_id") // email or wallet address
  embeddedWallet String? @map("embedded_wallet") // embedded wallet address
  accountId      String? @map("account_id") // account identifier

  // Traditional fields (optional for Privy users)
  email          String? @unique
  username       String? @unique
  hashedPassword String? @map("hashed_password") // Not needed for Privy users

  // User profile fields
  fullName    String?   @map("full_name")
  phoneNumber String?   @map("phone_number")
  userType    String?   @map("user_type")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  // Relationships
  ownedProperties  Property[]      @relation("PropertyOwner")
  tenantAgreements RentAgreement[] @relation("RentAgreementTenant")
  paymentsMade     Payment[]       @relation("PaymentPayer")

  @@map("users")
}

model Property {
  id                  Int     @id @default(autoincrement())
  title               String
  description         String?
  enhancedDescription String? @map("enhanced_description") // LLM enhanced description

  // Property details
  numberOfRooms     Int     @map("number_of_rooms")
  hasKitchen        Boolean @default(false) @map("has_kitchen")
  hasBathroom       Boolean @default(false) @map("has_bathroom")
  numberOfBathrooms Int     @default(1) @map("number_of_bathrooms")

  // Financial details
  rentAmount    Float  @map("rent_amount")
  depositAmount Float  @default(0.0) @map("deposit_amount")
  paymentMode   String @map("payment_mode")

  // Location details
  address String
  city    String
  state   String
  country String
  pincode String

  // Status
  isOccupied Boolean @default(false) @map("is_occupied")
  isActive   Boolean @default(true) @map("is_active")

  // Foreign keys
  ownerId Int @map("owner_id")

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  // Relationships
  owner          User            @relation("PropertyOwner", fields: [ownerId], references: [id])
  rentAgreements RentAgreement[] @relation("PropertyRentAgreements")

  @@map("properties")
}

model RentAgreement {
  id              Int    @id @default(autoincrement())
  agreementNumber String @unique @map("agreement_number")

  // Agreement details
  startDate           DateTime @map("start_date")
  endDate             DateTime @map("end_date")
  agreementSpanMonths Int      @map("agreement_span_months")

  // Financial terms
  monthlyRent     Float  @map("monthly_rent")
  securityDeposit Float  @map("security_deposit")
  paymentMode     String @map("payment_mode")

  // Terms and conditions
  conditions   String?
  specialTerms String? @map("special_terms")

  // Status
  isActive          Boolean   @default(true) @map("is_active")
  isTerminated      Boolean   @default(false) @map("is_terminated")
  terminationDate   DateTime? @map("termination_date")
  terminationReason String?   @map("termination_reason")

  // Foreign keys
  propertyId Int @map("property_id")
  tenantId   Int @map("tenant_id")

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  // Relationships
  property Property  @relation("PropertyRentAgreements", fields: [propertyId], references: [id])
  tenant   User      @relation("RentAgreementTenant", fields: [tenantId], references: [id])
  payments Payment[] @relation("RentAgreementPayments")

  @@map("rent_agreements")
}

model Payment {
  id               Int    @id @default(autoincrement())
  paymentReference String @unique @map("payment_reference")

  // Payment details
  amount      Float
  currency    String @default("USD")
  paymentType String @map("payment_type") // rent, deposit, maintenance, etc.

  // Payment method and status
  paymentMethod String? @map("payment_method") // x402, bank_transfer, cash, etc.
  status        String  @default("PENDING")

  // X402 specific fields
  x402PaymentId       String? @map("x402_payment_id") // X402 payment identifier
  x402TransactionHash String? @map("x402_transaction_hash") // Blockchain transaction hash

  // Payment periods
  paymentPeriodStart DateTime? @map("payment_period_start")
  paymentPeriodEnd   DateTime? @map("payment_period_end")
  dueDate            DateTime  @map("due_date")

  // Additional details
  description String?
  notes       String?

  // Foreign keys
  payerId         Int @map("payer_id")
  rentAgreementId Int @map("rent_agreement_id")

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  paidAt    DateTime? @map("paid_at")

  // Relationships
  payer         User          @relation("PaymentPayer", fields: [payerId], references: [id])
  rentAgreement RentAgreement @relation("RentAgreementPayments", fields: [rentAgreementId], references: [id])

  @@map("payments")
}
